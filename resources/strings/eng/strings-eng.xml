<strings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- General -->
    <string id="Loading">Loading...</string>
    <string id="EmptyPage">This page is empty</string>
    <string id="NotAvailable">n/a</string>

    <!-- Default label of the derived group control entry -->
    <string id="GroupControlAll">All</string>

    <!-- Settings menu -->
    <string id="Settings">Settings</string>
    <string id="SettingsAppVersion">App Version</string>
    <string id="SettingsServer">Server</string>
