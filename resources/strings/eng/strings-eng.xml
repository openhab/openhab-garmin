    <string id="SettingsLastSitemapUpdate">Last Sitemap Update</string>
    <string id="SettingsUpdateSitemap">Update Sitemap&#10;over Wi-Fi</string>

    <!-- App settings (scope=settings, not loaded at runtime) -->
    <string id="AppSettingUrl" scope="settings">URL (e.g. https://yourhost:yourport). Note: HTTP works only on iOS; Android requires HTTPS with a valid certificate. For myopenhab.org, use https://home.myopenhab.org.</string>
    <string id="AppSettingSitemapName" scope="settings">Sitemap Name</string>
    <string id="AppSettingRestApi" scope="settings">Enable this option if your openHAB installation supports the JSON-based REST API for sending commands.</string>
    <string id="AppSettingWebhook" scope="settings">Webhook Identifier - A way to send commands if the JSON-based REST API is not available. See the documentation for setup instructions.</string>
    <string id="AppSettingUserName" scope="settings">User Name (HTTP Basic Authentication)</string>
    <string id="AppSettingPassword" scope="settings">Password</string>
    <string id="AppSettingSuppressEmptyResponses" scope="settings">Suppress errors for empty sitemap responses. Recommended when using myopenhab.org, which occasionally returns empty results.</string>
    <string id="AppSettingPollingInterval" scope="settings">Polling interval (ms): Time between data requests to your openHAB instance. Set to 0 to request new data immediately after the previous response is processed.</string>
    <string id="AppSettingPostCommandHoldTime" scope="settings">Post command hold time (ms): Time during which state updates are ignored after a command is sent. This prevents temporary state flip-flopping while the system processes the command and applies the new state. Set to 0 to disable.</string>

    <!-- Connection state descriptions -->
    <string id="ConnectionModePhoneBle">Phone (BLE)</string>
