# Example environment for the E2E harness.
#
#   cp .env.example .env
#   python -m e2e pin-images --write    # from tests/runner; adds @sha256 digests
#   docker compose up -d                # stable profile
#
# Dev milestone instead of stable:
#
#   COMPOSE_PROFILES=dev docker compose -f compose.yaml -f compose.dev.yaml up -d
#
# Dedicated Linux host with host networking (loopback only):
#
#   docker compose -f compose.yaml -f compose.host.yaml up -d
#
# `.env` is ignored by git: it contains a machine-specific SDK path. The image
# variables below are rewritten by `pin-images --write`; until then they are
# tag-only and `pin-images --check` will refuse them.
#
# The published host ports are loopback-only. External access, including TLS
# termination, is the operator's reverse proxy; the harness stores no
# certificate, key or CA material.

# --- Compose ---------------------------------------------------------------
# `stable` is the default target. The two profiles never run together.
COMPOSE_PROFILES=stable
COMPOSE_PROJECT_NAME=openhab-garmin-e2e

# --- Image pins (rewritten by pin-images --write) --------------------------
# Tags must match tests/config/openhab.version.
OPENHAB_STABLE_IMAGE=openhab/openhab:5.2.5-debian
OPENHAB_DEV_IMAGE=openhab/openhab:5.3.0.M5-debian
RUNNER_BASE_IMAGE=ubuntu:24.04
SHIM_BASE_IMAGE=python:3.12-slim-bookworm

# Tags of the two images built from this repository.
RUNNER_VERSION=dev
SHIM_VERSION=dev

# --- Network (generated from tests/config/network.yaml) --------------------
# Single source of truth for the stack's loopback host and ports. The bridge
# profile publishes these ports on loopback only; the host overlay addresses
# the services on the same host and ports. Do not edit by hand: run
# `python -m e2e network-env --write` from tests/runner after changing
# network.yaml. `python -m pytest` fails when this block has drifted.
# >>> network >>>
E2E_LOOPBACK_HOST=127.0.0.1
OPENHAB_STABLE_PORT=8080
OPENHAB_DEV_PORT=8080
SHIM_PORT=8081
# <<< network <<<

# --- Wiring ----------------------------------------------------------------
# Bridge profile only: services reach each other through the Compose service
# aliases. The host overlay (compose.host.yaml) replaces these with
# http://127.0.0.1:<port>.
# The app is configured to talk to the shim, never to openHAB directly.
# Under the dev profile, compose.dev.yaml overrides both of these.
OPENHAB_UPSTREAM=http://openhab-stable:8080
E2E_OPENHAB_URL=http://openhab-stable:8080
E2E_SHIM_URL=http://shim:8080

# --- Connect IQ SDK --------------------------------------------------------
# Absolute path to the SDK root on the *host* (the directory containing
# version.txt, linux/bin/monkeyc and windows/bin/simulator.exe). It is mounted
# read-only at /opt/ciq-sdk. monkeyc writes into the SDK (it rewrites
# bin/default.jungle), so the runner copies the mount to a writable path at
# container start and compiles there; the mount itself is never written.
#
# The SDK is never committed and never part of an image; see tests/docs/sdk.md
# for the licence rules.
# Example (Linux): /opt/garmin/connectiq-sdk-9.3.0
CIQ_SDK_HOST_PATH=

# Optional: absolute host path to Connect IQ device definitions, when the SDK
# above does not ship a Devices/ directory. It is mounted read-only at
# /opt/ciq-devices and copied to $HOME/.Garmin/ConnectIQ/Devices inside the
# runner, which is where monkeyc resolves -d <device>. Leave empty to use the
# definitions inside the SDK.
CIQ_DEVICES_HOST_PATH=

# The Connect IQ device font pack. The simulator opens this directory before
# every draw; with it empty the app crashes on its first draw with
# "Invalid Font Specified" and nothing renders, so the runner fails to start
# without it rather than producing a run that asserts nothing about the UI.
# The SDK archive does not ship these files. Copy the Fonts directory from a
# working Connect IQ installation (on Windows
# %APPDATA%\Garmin\ConnectIQ\Fonts) and point this at it. It is mounted
# read-only at /opt/ciq-fonts and linked to $HOME/.Garmin/ConnectIQ/Fonts and
# the Wine prefix's ConnectIQ/Fonts.
#
# These are licensed Garmin assets: mount or copy them, never commit them and
# never bake them into an image. See tests/docs/sdk.md.
# Example (Linux): /home/<user>/.Garmin/ConnectIQ/Fonts
CIQ_FONTS_HOST_PATH=

# --- Repository root (runner mount) ---------------------------------------
# Relative to tests/compose/; override when running the compose file from
# somewhere else. The staging services always copy ../fixtures relative to this
# compose file, while the runner mounts ../fixtures at /e2e-fixtures and the
# checkout (this variable) at /work. Pointing this at a different checkout makes
# `e2e verify-fixtures` fail with "does not match the checkout fixture tree";
# start the stack from the checkout under test instead.
E2E_REPO_ROOT=../..

# --- openHAB ---------------------------------------------------------------
OPENHAB_JAVA_OPTS=-Duser.timezone=UTC
