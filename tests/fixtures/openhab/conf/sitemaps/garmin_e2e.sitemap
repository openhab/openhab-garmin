// Element and rendering fixture for the openHAB Garmin E2E harness.
//
// This is the small default sitemap (`garmin_e2e`) used by the smoke and
// protocol scenarios. It deliberately contains only element types, nesting,
// formats, ranges and icons. Commands live in `garmin_commands.sitemap`,
// dynamic visibility/colors in `garmin_dynamic.sitemap`, and command
// confirmation in the dev-only overlay.
//
// Size matters: the Connect IQ simulator rejects a JSON response above 16 KiB
// with -402 (measured; see tests/docs/fixture-limits.md). Each fixture sitemap
// must stay well below that, so do not grow this file with command or dynamic
// cases; add them to the matching sitemap instead.
//
// The app polls this sitemap with GET {url}rest/sitemaps/garmin_e2e; the
// sitemap name in the app settings fixture must match the file name.

sitemap garmin_e2e label="My Home" {

	// --- Text --------------------------------------------------------------
	Frame label="Text" {
		Text item=E2E_Temperature label="Temperature"
		Text item=E2E_TV label="TV [Channel: %s]"
		Text item=E2E_Window label="Window"
		Text item=E2E_LastUpdate label="Last Update"
		Text label="This text has no item"
		Text label="Nested page" {
			Text label="Nested static text"
			Text item=E2E_Temperature label="Nested temperature"
		}
	}

	// --- Default -----------------------------------------------------------
	// The app resolves Default to the widget of the item type.
	Frame label="Default" {
		Default item=E2E_Light2 label="Default Switch"
		Default item=E2E_Dimmer label="Default Dimmer"
		Default item=E2E_Rollershutter label="Default Shutters"
		Default item=E2E_Temperature label="Default Temperature"
		Default item=E2E_TV label="Default String"
	}

	// --- Setpoint and Slider ----------------------------------------------
	Frame label="Setpoint and Slider" {
		Setpoint item=E2E_Setpoint label="Setpoint" minValue=16 maxValue=30 step=0.5
		Slider item=E2E_Slider label="Slider" minValue=0 maxValue=100 step=10
		Slider item=E2E_Slider label="Slider Release Only" minValue=0 maxValue=50 step=0.5 releaseOnly
	}

	// --- Icons -------------------------------------------------------------
	Frame label="Icons" {
		Switch item=E2E_Light label="Light" icon=light
		Slider item=E2E_Dimmer label="Slider" minValue=0 maxValue=100 step=10 icon=light
		Switch item=E2E_Rollershutter label="Shutters" icon=rollershutter
		Switch item=E2E_TV label="TV [Channel: %s]" icon=screen mappings=[0="ABC", 1="BBC", 2="CNN"]
		Text item=E2E_Temperature label="Gates" icon=garagedoor
		// In the sitemap DSL `staticIcon` names the icon to use and marks it
		// static in the same step; it is not a boolean parameter.
		Text item=E2E_Temperature label="Vehicle SoC" staticIcon=batterylevel
		// No icon parameter at all: exercises the state-derived default icon.
		Text item=E2E_Temperature label="No Icon"
	}

	// --- Empty page --------------------------------------------------------
	// No braces: the DSL rejects a linkable block with no child element. A
	// Frame without a block is valid and openHAB serializes it as
	// `"widgets": []`, which the app turns into the empty-page toast.
	Frame label="Empty"
}